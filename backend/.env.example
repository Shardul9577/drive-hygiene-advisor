# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS + OAuth return).
# First entry is the default redirect after Google login.
FRONTEND_URL=http://localhost:5173,https://drive-hygiene-advisor-two.vercel.app
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: where scan history + audit JSONL are written (defaults to ./data)
# DATA_DIR=./data

# Session / access-token lifetimes (ms). Keep these aligned — Google access
# tokens last ~1 hour, so the cookie must not outlive a usable credential.
# SESSION_MAX_AGE_MS=3300000
# ACCESS_TOKEN_TTL_MS=3300000

# Scan page budgets (100 files per page). MVP default: 10 pages (~1,000 files).
# Raise these for production / larger drives.
# SCAN_MAX_PAGES=10
# SCAN_MAX_PAGES_HARD_CAP=50

# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins:
#   http://localhost:5173
#   https://drive-hygiene-advisor-two.vercel.app
# Authorized redirect URIs:
#   http://localhost:4000/api/auth/google/callback
#   https://drive-hygiene-advisor-two.vercel.app/api/auth/google/callback
#   (optional direct) https://drive-hygiene-advisor.onrender.com/api/auth/google/callback
#
# On Render, point the callback at the Vercel proxy so the session cookie is set
# on the frontend domain (browsers block cross-site cookies to onrender.com):
# GOOGLE_CALLBACK_URL=https://drive-hygiene-advisor-two.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Optional: force mock Drive metadata even when signed in
USE_MOCK_DRIVE=false
